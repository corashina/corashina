{
  "name": "corashina-profile",
  "private": true,
  "type": "module",
  "description": "Generates the art and cards for the corashina GitHub profile README.",
  "engines": { "node": ">=20" },
  "scripts": {
    "art": "node scripts/build-art.mjs",
    "cards": "node scripts/build-cards.mjs",
    "cards:sample": "node scripts/build-cards.mjs --sample --out dist",
    "eel": "node scripts/frame-eel.mjs dist",
    "readme": "node scripts/build-readme.mjs",
    "check": "node scripts/check.mjs assets/*.svg dist/*.svg"
  }
}
